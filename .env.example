# Server-side only. Never prefix this variable with VITE_ and never expose it
# through vite.config.ts `define`.
OPENAI_API_KEY=your_openai_api_key_here

# Optional (deployment): requests per IP per 10 minutes, default 80.
# RATE_LIMIT_MAX_REQUESTS=80
# Optional (deployment): extra origins allowed to call /api/ai, comma-separated.
# ALLOWED_ORIGINS=https://your-domain.example
